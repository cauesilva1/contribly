generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ProjectSource {
  manual
  github_import
}

enum MatchStatus {
  pending
  accepted
  rejected
}

enum InviteStatus {
  pending
  accepted
  rejected
}

enum ExperienceLevel {
  beginner
  intermediate
  advanced
}

enum ContributorRole {
  developer
  designer
  docs
  community
  other
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  githubId      String?   @unique
  githubUsername String?
  /// ID do usuário no Supabase Auth (login e-mail/senha).
  supabaseUserId String?  @unique
  role          ContributorRole @default(developer)
  bio           String?
  languages     String[]  @default([])
  interestTags  String[]  @default([])
  experienceLevel ExperienceLevel @default(beginner)
  openToInvites Boolean   @default(true)
  welcomeSeenAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?

  accounts      Account[]
  sessions      Session[]
  ownedProjects Project[]        @relation("ProjectOwner")
  interests     MatchInterest[]
  sentInvites   Invite[]         @relation("InviteFrom")
  receivedInvites Invite[]       @relation("InviteTo")
  notifications Notification[]
  participations ProjectParticipation[]
  messages      MatchMessage[]
  maintainerInvitesCreated MaintainerInvite[] @relation("MaintainerInviteCreator")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Project {
  id           String        @id @default(cuid())
  title        String
  description  String
  languages    String[]      @default([])
  tags         String[]      @default([])
  lookingFor   String[]      @default([])
  githubLink   String
  githubRepoId String?
  source       ProjectSource @default(manual)
  starsCount   Int?
  issuesSyncedAt DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  ownerId      String
  owner        User          @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  interests      MatchInterest[]
  invites        Invite[]
  participations ProjectParticipation[]
  issues         ProjectIssue[]
  messages       MatchMessage[]
  maintainerInvites MaintainerInvite[]
}

model MatchInterest {
  id        String      @id @default(cuid())
  userId    String
  projectId String
  status    MatchStatus @default(pending)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
}

model Invite {
  id         String       @id @default(cuid())
  fromUserId String
  toUserId   String
  projectId  String
  message    String?
  issueUrl   String?
  issueTitle String?
  issueNumber Int?
  status     InviteStatus @default(pending)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  fromUser User    @relation("InviteFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User    @relation("InviteTo", fields: [toUserId], references: [id], onDelete: Cascade)
  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([toUserId, projectId])
}

model ProjectIssue {
  id            String   @id @default(cuid())
  projectId     String
  githubIssueId String
  number        Int
  title         String
  url           String
  labels        String[] @default([])
  fetchedAt     DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, githubIssueId])
  @@index([projectId])
}

model MatchMessage {
  id        String   @id @default(cuid())
  projectId String
  senderId  String
  body      String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sender  User    @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

model ProjectParticipation {
  id        String   @id @default(cuid())
  userId    String
  projectId String
  joinedAt  DateTime @default(now())
  isActive  Boolean  @default(true)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  href      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Link mágico para avisar/convidar o mantenedor (com ou sem conta no Contribly).
model MaintainerInvite {
  id          String    @id @default(cuid())
  token       String    @unique
  projectId   String
  createdById String
  interestId  String?
  emailSentTo String?
  emailSentAt DateTime?
  expiresAt   DateTime
  claimedAt   DateTime?
  claimedById String?
  createdAt   DateTime  @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User    @relation("MaintainerInviteCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([createdById])
}
