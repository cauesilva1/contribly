# Database (Supabase Postgres)
# Pooler (app / Vercel) — porta 6543
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direto (migrations) — porta 5432
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Auth.js
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
# Produção: URL pública do app na Vercel (com https://)
# AUTH_URL="https://contribly.vercel.app"

# Opcional: higher GitHub API rate limit for repo/issue sync
# GITHUB_TOKEN=""
# OAuth do login já pede scope "repo" para importar públicos e privados (estilo Vercel).
# Quem logou antes precisa reconectar o GitHub em /projects/new.

# Opcional: protege /api/cron/sync-issues (Vercel Cron envia Bearer CRON_SECRET)
# CRON_SECRET=""

# Opcional: página /metrics (signups, swipes, matches)
# ADMIN_EMAIL="voce@email.com"
# ADMIN_GITHUB="seu-user-github"

# Opcional: e-mail ao mantenedor quando há interesse (https://resend.com)
# RESEND_API_KEY=""
# EMAIL_FROM="Contribly <onboarding@resend.dev>"

# Auth e-mail/senha (Supabase Auth) — ver docs/AUTH_EMAIL.md
# NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# SUPABASE_SERVICE_ROLE_KEY=""
